# 复制为 application-local.yml（已在 .gitignore）
# 在下方填写百炼 Key 与模型名，保存后直接 mvn spring-boot:run，无需每次设环境变量

spring:
  ai:
    dashscope:
      api-key: sk-在此填写你的百炼APIKey
      chat:
        options:
          model: qwen-turbo
      embedding:
        enabled: true
        options:
          model: text-embedding-v3
          dimensions: 1024
  datasource:
    url: jdbc:postgresql://localhost:5432/xhsagent?currentSchema=app
    username: xhsagent
    password: xhsagent_dev
    driver-class-name: org.postgresql.Driver
  data:
    redis:
      host: localhost
      port: 6379
  flyway:
    enabled: true
    locations: classpath:db/migration

logging:
  level:
    com.shortvideoscripagent.xhsagentyunying: DEBUG
    org.springframework.ai: INFO

app:
  ai:
    mock-enabled: false
    dashscope:
      vision-model: qwen-vl-plus
  agent:
    enabled: true
    mock-enabled: false
    tools:
      web-search: true
      fetch-url: true
  rag:
    enabled: true
    analysis-enabled: true
    title-enabled: true
