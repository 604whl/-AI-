# XhsAgent 部署环境变量示例
# 复制为 .env 并填写真实值；任何缺失都会导致应用启动失败（安全护栏已启用）

# ============ 部署模式（必填）============
# 生产环境必须设 prod
SPRING_PROFILES_ACTIVE=prod

# ============ 数据库（必填）============
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/xhsagent?currentSchema=app
SPRING_DATASOURCE_USERNAME=xhsagent
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ============ Redis（必填）============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ============ MinIO / 对象存储（必填）============
STORAGE_TYPE=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=xhs-agent

# ============ JWT（必填，>= 32 字节随机字符串）============
# 生成方式：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_RANDOM_48_BYTES_BASE64

# ============ CORS（必填，https 域名，逗号分隔）============
# CorsStartupValidator 会拒绝包含 localhost/127.0.0.1 的配置
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ============ AI 模型（必填）============
AI_MOCK_ENABLED=false
AI_DEFAULT_PROVIDER=deepseek
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=sk-CHANGE_ME_DEEPSEEK_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ============ Agent 工具开关（按需开启）============
AGENT_ENABLED=true
MCP_SERVER_ENABLED=false
MCP_API_KEY=CHANGE_ME_MCP_API_KEY

# ============ Web Search（可选）============
WEB_SEARCH_API_KEY=

# ============ 知识库（可选）============
KB_SOURCE_DIR=/app/data/kb-sources
